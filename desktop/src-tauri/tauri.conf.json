{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kioku",
  "version": "0.1.0",
  "identifier": "dev.kioku.desktop",
  "build": { "frontendDist": "../web" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "kioku", "width": 1280, "height": 800, "minWidth": 704, "minHeight": 480 }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false }
}
